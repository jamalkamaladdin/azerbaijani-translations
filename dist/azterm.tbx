   <langSet xml:lang="en"><tig><term>Warning</term></tig></langSet>
   <langSet xml:lang="az"><tig><term>Xəbərdarlıq</term></tig></langSet>
  </termEntry>
  <termEntry id="yes">
   <langSet xml:lang="en"><tig><term>Yes</term></tig></langSet>
   <langSet xml:lang="az"><tig><term>Bəli</term></tig></langSet>
  </termEntry>
 </body></text>
</martif>
